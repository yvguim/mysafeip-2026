# Copy to .env and uncomment the settings you need.

# Optional: generate with openssl rand -hex 32 to keep sessions across restarts.
# If unset or empty, a new secret is generated at each start without logging it.
# JWT_SECRET=

# Optional: Docker Hub tag, host loopback port, public URL, and language (fr or en).
# MYSAFEIP_IMAGE_TAG=docker-v0.13.1
# MYSAFEIP_PORT=8000
# MYSAFEIP_URL=http://127.0.0.1:8000
# MYSAFEIP_LANGUAGE=fr

# Optional: trusted reverse-proxy IPs/CIDRs as seen by the container (comma-separated).
# An empty value disables trust; don't use a wildcard.
# MYSAFEIP_FORWARDED_ALLOW_IPS=127.0.0.1,::1